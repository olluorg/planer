# Скопируйте в .env и заполните:  cp .env.example .env
# install.sh делает это сам и генерирует пароль базы.

# Домен sync-сервера. A-запись должна указывать на IP этой машины.
SYNC_DOMAIN=sync.thedad.ru

# Почта для Let's Encrypt (обязательно): туда придёт письмо, если сертификат не продлится.
ACME_EMAIL=

# Пароль Postgres. Длинный и случайный: openssl rand -base64 32
POSTGRES_PASSWORD=

# С каких адресов приложению можно обращаться к серверу, через запятую:
#  - https://thedad.ru     — веб-версия
#  - app://planer          — десктоп (Electron)
#  - chrome-extension://ID — расширение; ID появится после публикации в Chrome Web Store
ALLOWED_ORIGINS=https://thedad.ru,app://planer

# Запросов в минуту с одного IP (общий потолок; вход и регистрация ограничены жёстче).
RATE_LIMIT_MAX=120

# --- Резервные копии (scripts/backup.sh) ---
# Сколько дней хранить локальные дампы.
BACKUP_KEEP_DAYS=14
# Удалённое хранилище rclone для копии вне дома, например  yadisk:thedad-backups
# Пусто — копии только локальные (не спасут от пожара, кражи или смерти диска).
BACKUP_RCLONE_REMOTE=
# Пароль, которым шифруется дамп перед отправкой наружу. Храните отдельно от сервера!
BACKUP_PASSPHRASE=
# Необязательно: адрес пинга healthchecks.io — придёт письмо, если бэкап не выполнился.
BACKUP_PING_URL=
