{
  "name": "thedad-planer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first планер целей с прогнозированием результата. SQLite WASM, без сервера.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://thedad.ru",
  "repository": {
    "type": "git",
    "url": "https://github.com/uyellowline/planer.git"
  },
  "bugs": {
    "url": "https://github.com/uyellowline/thedad-releases/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ext": "node scripts/build-ext.mjs",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "desktop:icon": "node scripts/make-icon.mjs",
    "desktop:pack": "bun run build && electron-builder --dir",
    "desktop:dist": "bun run desktop:icon && bun run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/ed25519": "^3.1.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.6",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.460.0",
    "motion": "^12.42.2",
    "nanoid": "^5.0.8",
    "postcss": "^8.4.49",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "1.5.2",
    "react-router-dom": "^6.30.4",
    "sharp": "^0.35.3",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "^4.1.11",
    "zustand": "^5.0.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.thedad.planer",
    "productName": "THEDAD",
    "publish": [
      {
        "provider": "github",
        "owner": "uyellowline",
        "repo": "thedad-releases"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/wallpapers/**",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "THEDAD"
    },
    "portable": {
      "artifactName": "THEDAD-${version}-portable.exe"
    }
  }
}
