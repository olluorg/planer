# Адрес sync-сервера, вшивается в сборку фронта.
# Локальная разработка: можно не задавать — используется http://localhost:8787
# Прод (обязательно https, иначе браузер заблокирует запросы со страницы https):
VITE_SYNC_SERVER_URL=https://sync.example.com

# Платные функции (синхронизация через наш сервер). Пустое/отсутствует — скрыты.
# Включать только в сборках, где биллинг реально работает.
VITE_FEATURE_PLUS=

# Бэкап в Google Диск (папка appDataFolder). Создаётся в Google Cloud Console:
# тип клиента «Web application», scope drive.appdata, в Authorized JavaScript
# origins — домен приложения. Пусто — раздел в Настройках скрыт.
VITE_GOOGLE_CLIENT_ID=
